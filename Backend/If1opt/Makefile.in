if1opt$(EXEEXT): $(if1opt_OBJECTS) $(if1opt_DEPENDENCIES) $(EXTRA_if1opt_DEPENDENCIES) 
	@rm -f if1opt$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(if1opt_OBJECTS) $(if1opt_LDADD) $(LIBS)

if1pprint$(EXEEXT): $(if1pprint_OBJECTS) $(if1pprint_DEPENDENCIES) $(EXTRA_if1pprint_DEPENDENCIES) 
	@rm -f if1pprint$(EXEEXT)
	$(AM_V_CCLD)$(LINK) $(if1pprint_OBJECTS) $(if1pprint_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

